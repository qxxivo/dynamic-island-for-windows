<Application x:Class="IslandApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ===== Цвета (палитра Apple, тёмная тема) ===== -->
        <SolidColorBrush x:Key="Surface" Color="#1C1C1E"/>
        <SolidColorBrush x:Key="Surface2" Color="#2C2C2E"/>
        <SolidColorBrush x:Key="Separator" Color="#38383A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8E8E93"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#636366"/>
        <SolidColorBrush x:Key="Accent" Color="#0A84FF"/>
        <SolidColorBrush x:Key="Green" Color="#30D158"/>
        <SolidColorBrush x:Key="Orange" Color="#FF9F0A"/>
        <SolidColorBrush x:Key="Red" Color="#FF453A"/>
        <SolidColorBrush x:Key="GreenTint" Color="#2630D158"/>
        <SolidColorBrush x:Key="RedTint" Color="#26FF453A"/>
        <SolidColorBrush x:Key="Hover" Color="#1FFFFFFF"/>

        <!-- ===== Иконки ===== -->
