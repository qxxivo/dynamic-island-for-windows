<UserControl x:Class="IslandApp.TimerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Таймер -->
        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="Таймер" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
            <TextBlock x:Name="TimerText" Text="05:00" FontSize="36" FontWeight="Light"
                       Margin="0,2,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Style="{StaticResource PillButton}" Content="−1" Tag="-1" Click="AdjustClick"/>
                <Button Style="{StaticResource PillButton}" Content="+1" Tag="1" Click="AdjustClick"/>
                <Button Style="{StaticResource PillButton}" Content="+5" Tag="5" Click="AdjustClick"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="StartButton" Style="{StaticResource AccentButton}"
                        Content="Старт" Click="StartClick"/>
                <Button Style="{StaticResource PillButton}" Content="Сброс" Click="ResetClick"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Column="1" Background="{StaticResource Separator}"/>

        <!-- Будильник -->
        <StackPanel Grid.Column="2" Margin="16,0,0,0">
            <TextBlock Text="Будильник" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
            <TextBox x:Name="AlarmBox" Text="07:30" MaxLength="5"
                     Style="{StaticResource Field}" FontSize="26" FontWeight="Light"
                     Width="120" HorizontalAlignment="Left" Margin="0,6,0,10"/>
            <Button x:Name="AlarmButton" Style="{StaticResource AccentButton}"
                    Content="Поставить" HorizontalAlignment="Left" Click="AlarmClick"/>
            <TextBlock x:Name="AlarmStatus" Text="Не установлен" FontSize="11"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Экран сигнала -->
        <Border x:Name="RingOverlay" Grid.ColumnSpan="3" Background="Black" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="RingTitle" Text="Сигнал" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <Button Style="{StaticResource DangerButton}" Content="Стоп"
                        Margin="0,14,0,0" HorizontalAlignment="Center" Click="StopClick"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>